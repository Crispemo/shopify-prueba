            "custom_liquid": "<div style=\"margin:8px 0\"><div class=\"product-form__input\" style=\"margin-bottom:8px\"><label class=\"form__label\" for=\"pc-ancho\">Ancho en centímetros <span style=\"display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border:1px solid #aaa;border-radius:50%;font-size:9px;cursor:help;color:#888;margin-left:4px;vertical-align:middle\" title=\"Mide el hueco de izquierda a derecha\">&#9432;<\/span><\/label><div class=\"field\"><input type=\"number\" id=\"pc-ancho\" class=\"field__input\" name=\"properties[Ancho (cm)]\" min=\"30\" max=\"700\" placeholder=\"100\" autocomplete=\"off\"><\/div><\/div><div class=\"product-form__input\" style=\"margin-bottom:8px\"><label class=\"form__label\" for=\"pc-largo\">Largo en centímetros <span style=\"display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border:1px solid #aaa;border-radius:50%;font-size:9px;cursor:help;color:#888;margin-left:4px;vertical-align:middle\" title=\"Mide el hueco de arriba a abajo\">&#9432;<\/span><\/label><div class=\"field\"><input type=\"number\" id=\"pc-largo\" class=\"field__input\" name=\"properties[Largo (cm)]\" min=\"30\" max=\"700\" placeholder=\"100\" autocomplete=\"off\"><\/div><\/div><p id=\"pc-error\" style=\"display:none;color:rgb(192,57,43);font-size:.8125rem;margin:4px 0 8px\">No hacemos ese tamaño (mín. 30 cm · máx. 700 cm)<\/p><div id=\"pc-box\" style=\"padding:12px 16px;margin:12px 0;background:rgb(236,229,219);transition:background .2s\"><span style=\"display:block;font-size:.6875rem;letter-spacing:.1em;text-transform:uppercase;color:rgb(122,92,62)\">PRECIO TOTAL<\/span><span id=\"pc-val\" style=\"display:block;font-size:.875rem;color:#aaa;margin-top:4px\">Introduce tus medidas<\/span><\/div><input type=\"hidden\" name=\"properties[_precio_calculado]\" id=\"pc-hp\"><input type=\"hidden\" name=\"properties[_m2]\" id=\"pc-hm\"><\/div><script>(function(){var MIN=30,MAX=700;function rate(m2){return m2<1?150:m2<=3?105:95;}function up(){var aEl=document.getElementById('pc-ancho'),lEl=document.getElementById('pc-largo');if(!aEl||!lEl)return;var a=aEl.value?parseFloat(aEl.value):null,l=lEl.value?parseFloat(lEl.value):null;var err=document.getElementById('pc-error'),box=document.getElementById('pc-box'),val=document.getElementById('pc-val'),hp=document.getElementById('pc-hp'),hm=document.getElementById('pc-hm');var form=aEl.closest('form'),btn=form&&(form.querySelector('[name=add]')||form.querySelector('button[type=submit]'));var inv=(a!==null&&(a<MIN||a>MAX))||(l!==null&&(l<MIN||l>MAX));aEl.style.borderColor=(a!==null&&(a<MIN||a>MAX))?'rgb(192,57,43)':'';lEl.style.borderColor=(l!==null&&(l<MIN||l>MAX))?'rgb(192,57,43)':'';if(inv){err.style.display='block';box.style.background='rgb(248,224,221)';val.style.cssText='display:block;font-size:.875rem;color:rgb(192,57,43);margin-top:4px';val.textContent='No hacemos ese tamaño';if(btn)btn.disabled=true;hp.value='';hm.value='';return;}err.style.display='none';if(a===null||l===null){box.style.background='rgb(236,229,219)';val.style.cssText='display:block;font-size:.875rem;color:#aaa;margin-top:4px';val.textContent='Introduce tus medidas';if(btn)btn.disabled=true;hp.value='';hm.value='';return;}var q=1,qEl=form&&form.querySelector('[name=quantity]');if(qEl)q=parseInt(qEl.value)||1;var m2=a*l\/10000,r=rate(m2),u=Math.ceil(m2*r*100)\/100,t=Math.ceil(u*q*100)\/100;box.style.background='rgb(232,151,122)';val.style.cssText='display:block;font-size:1.75rem;font-weight:700;color:#fff;margin-top:4px';val.textContent='€ '+t.toFixed(2).replace('.',',');if(btn)btn.disabled=false;hp.value=t.toFixed(2);hm.value=m2.toFixed(4);}document.addEventListener('DOMContentLoaded',function(){var a=document.getElementById('pc-ancho'),l=document.getElementById('pc-largo');if(!a||!l)return;var form=a.closest('form'),btn=form&&(form.querySelector('[name=add]')||form.querySelector('button[type=submit]'));if(btn)btn.disabled=true;a.addEventListener('input',up);l.addEventListener('input',up);var q=form&&form.querySelector('[name=quantity]');if(q)q.addEventListener('change',up);});})();<\/script>"
