ft;\n    border: none;\n    outline: none;\n    transition: background-color 0.3s;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  .accordion:hover {\n    background-color: #f3a891; /* Cambiar color al pasar el ratón */\n  }\n\n  .arrow {\n    font-size: 12px; /* Tamaño del icono más pequeño */\n    margin-right: 5px; /* Espacio entre el texto y el icono */\n    transform: rotate(90deg); /* Girar el icono hacia el título */\n  }\n\n  .section-title {\n    text-transform: uppercase; /* Convertir a mayúsculas */\n    margin-left: 10px; /* Espaciado entre el texto y el icono */\n    display: flex;\n    align-items: center;\n  }\n\n  .panel {\n    display: none;\n    padding: 10px;\n  }\n\n  /* Mostrar/ocultar el acordeón al hacer clic en el botón */\n  .accordion.active {\n    background-color: #f3a891; /* Cambiar color cuando está abierto */\n  }\n\n  .accordion.active + .panel {\n    display: block;\n  }\n</style>\n\n<script>\n  // JavaScript para mostrar/ocultar la descripción al hacer clic en el botón\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    var accordions = document.querySelectorAll(\".accordion\");\n    var panels = document.querySelectorAll(\".panel\");\n\n    accordions.forEach(function(acc, index) {\n      acc.addEventListener(\"click\", function() {\n        panels[index].style.display = panels[index].style.display === \"block\" ? \"none\" : \"block\";\n        acc.classList.toggle(\"active\");\n      });\n    });\n  });\n</script>",
