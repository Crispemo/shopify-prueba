      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cuánto tiempo tarda el envío?",
            "answer": "<p>Los pedidos se envían en 24–72 horas laborables. Recibirás un email de confirmación con el número de seguimiento en cuanto salga del almacén.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cómo mido mi ventana para la persiana?",
            "answer": "<p>Mide el ancho y el alto del hueco en centímetros. Usa nuestro calculador de precio para obtener el importe exacto al instante.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "¿Puedo pedir medidas personalizadas?",
            "answer": "<p>Sí. Todas las persianas se fabrican a la medida exacta que introduzcas en el calculador. Medidas entre 30 y 700 cm.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cuál es la política de devoluciones?",
            "answer": "<p>Aceptamos devoluciones en los primeros 30 días desde la recepción del pedido, sin preguntas. El envío de vuelta corre de nuestra cuenta.</p>"
          }
        }
      },
      "block_order": ["faq_1", "faq_2", "faq_3", "faq_4"]
