e\" : \"block\";\n        acc.classList.toggle(\"active\");\n      });\n    });\n  });\n<\/script>","color_scheme":"","padding_top":12,"padding_bottom":28}},"1698940867ae431072":{"type":"apps","blocks":{"70d36934-7d25-464f-bcfe-d77652787203":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/featured_carousel\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{"maxwidth":1080}}},"block_order":["70d36934-7d25-464f-bcfe-d77652787203"],"disabled":true,"settings":{"include_margins":true}},"169764645112943b11":{"type":"apps","blocks":{"deba3e50-402d-4b83-bbfc-ea9236da8c8b":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/review_widget\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{}}},"block_order":["deba3e50-402d-4b83-bbfc-ea9236da8c8b"],"disabled":true,"settings":{"include_margins":true}},"169749724300248087":{"type":"apps","disabled":true,"settings":{"include_margins":true}},"16974971409eea9e6a":{"type":"apps","disabled":true,"settings":{"include_margins":true}},"16974971895a019701":{"type":"apps","disabled":true,"settings":{"include_margins":true}},"1697496141e5841143":{"type":"apps","disabled":true,"settings":{"include_margins":true}},"related-products":{"type":"related-products","disabled":true,"settings":{"heading":"Productos relacionados","heading_size":"h1","products_to_show":4,"columns_desktop":4,"color_scheme":"background-1","image_ratio":"square","image_shape":"default","show_secondary_image":true,"show_vendor":false,"show_rating":false,"columns_mobile":"2","padding_top":36,"padding_bottom":28}}},"order":["image_banner_gb4n8F","main","pagetify-template","734b1be2-fda0-49b2-b0ca-660cb6aaf036","daebecd6-6fe2-483d-98dd-42c93dbdf718","1698940867ae431072","169764645112943b11","169749724300248087","16974971409eea9e6a","16974971895a019701","1697496141e5841143","related-products"]}