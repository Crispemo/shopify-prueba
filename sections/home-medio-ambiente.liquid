<section class="h-eco color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    <div class="h-eco__header">
      <h2 class="h-eco__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="h-eco__body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div class="h-eco__pillars">
      {%- for block in section.blocks -%}
        <div class="h-eco__pillar" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <img
              src="{{ block.settings.icon | image_url: width: 120 }}"
              alt="{{ block.settings.title | escape }}"
              width="80"
              height="80"
              loading="lazy"
              class="h-eco__icon"
            >
          {%- else -%}
            <div class="h-eco__icon-ph">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="32" cy="32" r="28"/>
                <path d="M32 20 C20 28 20 44 32 44 C44 44 44 28 32 20Z"/>
              </svg>
            </div>
          {%- endif -%}
          <h3 class="h-eco__pillar-title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="h-eco__pillar-text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  .h-eco {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
  }

  .h-eco__header {
    text-align: center;
    margin-bottom: 56px;
  }

  .h-eco__title {
    font-size: clamp(1.125rem, 3vw, 1.625rem);
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0 0 20px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.3;
  }

  .h-eco__body {
    font-size: 1rem;
    color: var(--color-foreground);
    opacity: .75;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
    text-align: center;
  }

  .h-eco__pillars {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | default: 3 }}, 1fr);
    gap: 40px;
    text-align: center;
  }

  .h-eco__pillar { display: flex; flex-direction: column; align-items: center; gap: 16px; }

  .h-eco__icon {
    width: 80px;
    height: 80px;
    object-fit: contain;
    display: block;
  }

  .h-eco__icon-ph {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
  }
  .h-eco__icon-ph svg { width: 64px; height: 64px; }

  .h-eco__pillar-title {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }

  .h-eco__pillar-text {
    font-size: 0.9375rem;
    color: var(--color-foreground);
    opacity: .7;
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 749px) {
    .h-eco__pillars { grid-template-columns: 1fr; gap: 32px; }
  }
</style>

{% schema %}
{
  "name": "Medio ambiente / Valores",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "text",     "id": "heading", "label": "Título", "default": "TIENDA COMPROMETIDA CON EL MEDIO AMBIENTE" },
    { "type": "textarea", "id": "body",    "label": "Párrafo introductorio", "default": "Todos nuestros productos están elaborados con materiales reciclados o de origen natural, siguiendo procesos tradicionales que minimizan el impacto ambiental." },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 72 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pilar",
      "settings": [
        { "type": "image_picker", "id": "icon",  "label": "Icono (imagen PNG/SVG)" },
        { "type": "text",         "id": "title", "label": "Título", "default": "MATERIALES RECICLADOS" },
        { "type": "textarea",     "id": "text",  "label": "Descripción", "default": "Se utilizan materiales reciclados para reducir el impacto ambiental." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Medio ambiente / Valores",
      "blocks": [
        { "type": "pillar", "settings": { "title": "MATERIALES RECICLADOS",   "text": "Se utilizan materiales reciclados para reducir el impacto ambiental." } },
        { "type": "pillar", "settings": { "title": "PRODUCCIÓN ARTESANAL",    "text": "Todos los productos están hechos a mano, preservando las técnicas tradicionales." } },
        { "type": "pillar", "settings": { "title": "SOSTENIBILIDAD PRIMERO",  "text": "El uso de materiales naturales, como el esparto, garantiza una producción responsable." } }
      ]
    }
  ]
}
{% endschema %}
