{%- assign style = section.settings.style -%}

<section class="h-eco h-eco--{{ style }} color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    <div class="h-eco__header">
      <h2 class="h-eco__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="h-eco__body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div class="h-eco__pillars">
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index -%}
        <div class="h-eco__pillar" {{ block.shopify_attributes }}>

          {%- comment -%} Icon area {%- endcomment -%}
          <div class="h-eco__icon-wrap">
            {%- if block.settings.icon != blank -%}
              <img
                src="{{ block.settings.icon | image_url: width: 120 }}"
                alt="{{ block.settings.title | escape }}"
                width="80" height="80"
                loading="lazy"
                class="h-eco__icon-img"
              >
            {%- elsif style == 'elegante' -%}
              {%- case idx -%}
                {%- when 1 -%}
                  <svg class="h-eco__svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M32 52 C32 52 14 40 14 26 C14 18 20 12 28 13 C30 13.4 31.2 14 32 15 C32.8 14 34 13.4 36 13 C44 12 50 18 50 26 C50 40 32 52 32 52Z"/>
                    <path d="M32 15 C32 15 32 30 32 52"/>
                    <path d="M22 22 C26 24 30 28 32 32"/>
                    <path d="M42 22 C38 24 34 28 32 32"/>
                  </svg>
                {%- when 2 -%}
                  <svg class="h-eco__svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M20 44 L38 14"/>
                    <circle cx="40" cy="12" r="3"/>
                    <path d="M20 44 C18 48 20 54 24 54 C28 54 30 50 28 46 L20 44Z"/>
                    <path d="M32 20 C36 22 40 26 38 32 C36 36 30 36 28 32"/>
                    <path d="M24 30 C22 34 24 40 28 40"/>
                  </svg>
                {%- when 3 -%}
                  <svg class="h-eco__svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M22 40 C18 36 16 30 18 24 C20 18 26 14 32 14"/>
                    <path d="M42 40 C46 36 48 30 46 24 C44 18 38 14 32 14"/>
                    <path d="M26 48 C26 44 30 42 32 42 C34 42 38 44 38 48"/>
                    <path d="M20 44 C16 44 12 48 14 52 C16 56 22 56 26 52"/>
                    <path d="M44 44 C48 44 52 48 50 52 C48 56 42 56 38 52"/>
                    <path d="M32 14 L32 42"/>
                    <path d="M26 22 L38 22"/>
                    <path d="M24 30 L40 30"/>
                  </svg>
              {%- endcase -%}
            {%- elsif style == 'cards' -%}
              {%- case idx -%}
                {%- when 1 -%}
                  <svg class="h-eco__svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M24 38 C24 38 10 30 10 20 C10 14 15 10 20 11 C22 11.4 23 12 24 13 C25 12 26 11.4 28 11 C33 10 38 14 38 20 C38 30 24 38 24 38Z"/>
                    <path d="M24 13 L24 38"/>
                  </svg>
                {%- when 2 -%}
                  <svg class="h-eco__svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M15 34 L29 10"/><circle cx="30" cy="9" r="2.5"/>
                    <path d="M15 34 C13 37 15 42 18 42 C21 42 23 38 21 35 L15 34Z"/>
                    <path d="M24 15 C27 17 30 20 28 25 C26 29 22 28 21 25"/>
                  </svg>
                {%- when 3 -%}
                  <svg class="h-eco__svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M24 8 L26 14 L32 14 L27.5 18 L29.5 24 L24 20.5 L18.5 24 L20.5 18 L16 14 L22 14 Z"/>
                    <path d="M14 32 C12 28 13 23 16 20"/>
                    <path d="M34 32 C36 28 35 23 32 20"/>
                    <path d="M18 38 C18 35 21 33 24 33 C27 33 30 35 30 38"/>
                  </svg>
              {%- endcase -%}
            {%- else -%}
              <div class="h-eco__icon-ph">
                <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="32" cy="32" r="28"/>
                  <path d="M32 20 C20 28 20 44 32 44 C44 44 44 28 32 20Z"/>
                </svg>
              </div>
            {%- endif -%}
          </div>

          <h3 class="h-eco__pillar-title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="h-eco__pillar-text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  /* ── BASE ─────────────────────────────────── */
  .h-eco {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
  }

  .h-eco__header {
    text-align: center;
    margin-bottom: 56px;
  }

  .h-eco__title {
    font-size: clamp(1.125rem, 3vw, 1.625rem);
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0 0 20px;
    line-height: 1.3;
  }

  .h-eco__body {
    font-size: 1rem;
    color: var(--color-foreground);
    opacity: .7;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.75;
  }

  .h-eco__pillars {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | default: 3 }}, 1fr);
    gap: 40px;
    text-align: center;
  }

  .h-eco__pillar { display: flex; flex-direction: column; align-items: center; }
  .h-eco__icon-wrap { margin-bottom: 20px; }

  .h-eco__icon-img { width: 80px; height: 80px; object-fit: contain; display: block; }

  .h-eco__icon-ph {
    width: 80px; height: 80px;
    display: flex; align-items: center; justify-content: center; color: #aaa;
  }
  .h-eco__icon-ph svg { width: 64px; height: 64px; }

  /* ── ESTILO CLÁSICO (classic) ─────────────── */
  .h-eco--classic .h-eco__pillar-title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0 0 10px;
  }
  .h-eco--classic .h-eco__pillar-text {
    font-size: 0.9375rem;
    color: var(--color-foreground);
    opacity: .65;
    margin: 0;
    line-height: 1.65;
  }

  /* ── ESTILO ELEGANTE (elegante) ───────────── */
  .h-eco--elegante .h-eco__svg {
    width: 72px; height: 72px; color: #6b5c4e;
  }
  .h-eco--elegante .h-eco__icon-wrap { margin-bottom: 24px; }
  .h-eco--elegante .h-eco__pillar-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: .01em;
    text-transform: none;
    color: var(--color-foreground);
    margin: 0 0 10px;
  }
  .h-eco--elegante .h-eco__pillar-text {
    font-size: 0.9375rem;
    color: var(--color-foreground);
    opacity: .7;
    margin: 0;
    line-height: 1.7;
    text-align: center;
  }
  .h-eco--elegante .h-eco__pillars { gap: 48px; }
  .h-eco--elegante .h-eco__title {
    font-size: clamp(1.25rem, 3vw, 1.875rem);
    font-weight: 600;
    letter-spacing: .05em;
  }

  /* ── ESTILO CARDS (cards) ─────────────────── */
  .h-eco--cards .h-eco__pillars { gap: 24px; }

  .h-eco--cards .h-eco__pillar {
    background: #faf8f5;
    border-radius: 16px;
    padding: 36px 28px;
    border: 1px solid #ede8e2;
    transition: box-shadow .25s, transform .25s;
  }
  .h-eco--cards .h-eco__pillar:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,.07);
    transform: translateY(-3px);
  }

  .h-eco--cards .h-eco__svg {
    width: 52px; height: 52px; color: #c8824a;
  }
  .h-eco--cards .h-eco__icon-wrap {
    width: 80px; height: 80px;
    background: #fff;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px;
    border: 1px solid #ede8e2;
  }

  .h-eco--cards .h-eco__pillar-title {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #2b2118;
    margin: 0 0 12px;
  }
  .h-eco--cards .h-eco__pillar-text {
    font-size: 0.9375rem;
    color: #555;
    margin: 0;
    line-height: 1.65;
    text-align: center;
  }

  @media (max-width: 749px) {
    .h-eco__pillars { grid-template-columns: 1fr; gap: 24px; }
  }
</style>

{% schema %}
{
  "name": "Medio ambiente / Valores",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo visual",
      "options": [
        { "value": "classic",  "label": "Clásico — iconos con borde circular" },
        { "value": "elegante", "label": "Elegante — trazo artesanal a mano" },
        { "value": "cards",    "label": "Cards — tarjetas con fondo y hover" }
      ],
      "default": "elegante"
    },
    { "type": "text",     "id": "heading", "label": "Título", "default": "TIENDA COMPROMETIDA CON EL MEDIO AMBIENTE" },
    { "type": "textarea", "id": "body",    "label": "Párrafo introductorio", "default": "Todos nuestros productos están elaborados con materiales reciclados o de origen natural, siguiendo procesos tradicionales que minimizan el impacto ambiental." },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 72 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pilar",
      "settings": [
        { "type": "image_picker", "id": "icon",  "label": "Icono personalizado (PNG/SVG)", "info": "Opcional. Si no se sube, se usa el icono del estilo seleccionado." },
        { "type": "text",         "id": "title", "label": "Título", "default": "Materiales Reciclados" },
        { "type": "textarea",     "id": "text",  "label": "Descripción", "default": "Se utilizan materiales reciclados para reducir el desperdicio y promover la reutilización." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Medio ambiente / Valores",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Materiales Reciclados",   "text": "Se utilizan materiales reciclados para reducir el desperdicio y promover la reutilización." } },
        { "type": "pillar", "settings": { "title": "Producción Artesanal",    "text": "Todos los productos están hechos a mano, garantizando la calidad de las piezas." } },
        { "type": "pillar", "settings": { "title": "Sostenibilidad y Respeto","text": "El uso de materiales naturales, como el esparto, evita el uso de plásticos y materiales sintéticos." } }
      ]
    }
  ]
}
{% endschema %}
