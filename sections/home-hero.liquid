<section class="h-hero">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
      width="2000"
      height="{{ 2000 | divided_by: section.settings.image.aspect_ratio | round }}"
      loading="eager"
      fetchpriority="high"
      class="h-hero__img"
    >
  {%- else -%}
    <div class="h-hero__img h-hero__img--placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
  {%- endif -%}

  <div class="h-hero__overlay" style="opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>

  <div class="h-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="h-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="h-hero__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
      <a href="{{ section.settings.button_url }}" class="h-hero__btn">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

<style>
  .h-hero {
    position: relative;
    width: 100%;
    height: {{ section.settings.height }}px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .h-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .h-hero__img--placeholder {
    background: #ccc;
  }

  .h-hero__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    z-index: 1;
  }

  .h-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 24px;
  }

  .h-hero__heading {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: .04em;
    margin: 0 0 16px;
    line-height: 1.05;
  }

  .h-hero__sub {
    font-size: clamp(0.75rem, 1.8vw, 1rem);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: .18em;
    margin: 0 0 32px;
    opacity: .9;
  }

  .h-hero__btn {
    display: inline-block;
    background: #fff;
    color: #111;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: .06em;
    padding: 14px 36px;
    border: 2px solid #fff;
    transition: background .2s, color .2s;
  }

  .h-hero__btn:hover {
    background: transparent;
    color: #fff;
  }

  @media (max-width: 749px) {
    .h-hero { height: {{ section.settings.height_mobile }}px; }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image",      "label": "Imagen de fondo" },
    { "type": "range", "id": "overlay_opacity", "label": "Oscuridad del overlay (%)", "min": 0, "max": 80, "step": 5, "default": 30 },
    { "type": "text",  "id": "heading",    "label": "Título",    "default": "DECORA TU HOGAR" },
    { "type": "text",  "id": "subheading", "label": "Subtítulo", "default": "PRODUCTOS ARTESANALES DE ESPARTO Y YUTE" },
    { "type": "text",  "id": "button_label", "label": "Texto del botón", "default": "Ver productos" },
    { "type": "url",   "id": "button_url",   "label": "Enlace del botón" },
    { "type": "range", "id": "height",        "label": "Altura (px) — escritorio", "min": 300, "max": 900, "step": 20, "default": 700 },
    { "type": "range", "id": "height_mobile", "label": "Altura (px) — móvil",      "min": 200, "max": 700, "step": 20, "default": 480 }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
