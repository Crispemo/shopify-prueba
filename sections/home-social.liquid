<section class="h-social color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="h-social__header">
      <h2 class="h-social__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="h-social__body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="h-social__grid">
    {%- for block in section.blocks -%}
      <div class="h-social__item" {{ block.shopify_attributes }}>
        {%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}" target="_blank" rel="noopener">{%- endif -%}
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 600 }}"
            alt="{{ block.settings.image.alt | default: '' | escape }}"
            width="600"
            height="{{ 600 | divided_by: block.settings.image.aspect_ratio | round }}"
            loading="lazy"
            class="h-social__img"
          >
        {%- else -%}
          <div class="h-social__img h-social__img--ph">{{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag }}</div>
        {%- endif -%}
        {%- if block.settings.url != blank -%}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  .h-social {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
  }

  .h-social__header {
    text-align: center;
    margin-bottom: 40px;
    padding: 0 24px;
  }

  .h-social__title {
    font-size: clamp(1.125rem, 3vw, 1.625rem);
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0 0 16px;
  }

  .h-social__body {
    font-size: 0.9375rem;
    color: var(--color-foreground);
    opacity: .75;
    max-width: 760px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .h-social__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | default: 5 }}, 1fr);
    gap: 0;
  }

  .h-social__item { overflow: hidden; aspect-ratio: 1; }

  .h-social__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .4s ease;
  }
  .h-social__item:hover .h-social__img { transform: scale(1.06); }

  .h-social__img--ph {
    background: #e8e0d6;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .h-social__img--ph svg { width: 40px; opacity: .3; }

  .h-social__item a { display: block; height: 100%; }

  @media (max-width: 749px) {
    .h-social__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 399px) {
    .h-social__grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Social / UGC",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "text",     "id": "heading", "label": "Título", "default": "¡COMPARTE TU ESTILO CON NOSOTROS!" },
    { "type": "textarea", "id": "body",    "label": "Descripción", "default": "Sigue a Jarapa Home en nuestras redes sociales y descubre inspiración diaria para decorar tu hogar de forma sostenible. Etiqueta tu decoración con #JarapaHome para compartir tu estilo con nosotros." },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 0 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Foto",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "url",          "id": "url",   "label": "Enlace (opcional, p.ej. Instagram)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social / UGC",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
