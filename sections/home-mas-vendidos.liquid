<section class="h-mv">
  <div class="page-width">
    <h2 class="h-mv__title">{{ section.settings.heading }}</h2>
  </div>

  <div class="h-mv__wrap">
    <button class="h-mv__arrow h-mv__arrow--prev" aria-label="Anterior" data-dir="-1">&#8249;</button>

    <div class="h-mv__track" id="h-mv-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- assign prod = block.settings.product -%}
        {%- if prod != blank -%}
          <div class="h-mv__card" {{ block.shopify_attributes }}>
            <a href="{{ prod.url }}" class="h-mv__img-link">
              <img
                src="{{ prod.featured_image | image_url: width: 700 }}"
                alt="{{ prod.featured_image.alt | default: prod.title | escape }}"
                width="700"
                height="{{ 700 | divided_by: prod.featured_image.aspect_ratio | round }}"
                loading="lazy"
                class="h-mv__img"
              >
            </a>
            <div class="h-mv__info">
              <p class="h-mv__name">{{ prod.title }}</p>
              <a href="{{ prod.url }}" class="h-mv__btn">VER PRODUCTO</a>
            </div>
          </div>
        {%- else -%}
          <div class="h-mv__card" {{ block.shopify_attributes }}>
            <div class="h-mv__img-ph">{{ 'product-1' | placeholder_svg_tag }}</div>
            <div class="h-mv__info">
              <p class="h-mv__name">Producto</p>
              <span class="h-mv__btn">VER PRODUCTO</span>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <button class="h-mv__arrow h-mv__arrow--next" aria-label="Siguiente" data-dir="1">&#8250;</button>
  </div>
</section>

<style>
  .h-mv {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: #fff;
  }

  .h-mv__title {
    text-align: center;
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #111;
    margin: 0 0 36px;
  }

  .h-mv__wrap {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .h-mv__track {
    display: flex;
    overflow: hidden;
    flex: 1;
    scroll-behavior: smooth;
  }

  .h-mv__card {
    flex: 0 0 calc(100% / {{ section.settings.per_row }});
    display: flex;
    flex-direction: column;
    border-right: 1px solid #f0f0f0;
  }
  .h-mv__card:last-child { border-right: none; }

  .h-mv__img-link { display: block; overflow: hidden; }

  .h-mv__img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    display: block;
    transition: transform .45s ease;
  }
  .h-mv__img-link:hover .h-mv__img { transform: scale(1.05); }

  .h-mv__img-ph {
    width: 100%;
    aspect-ratio: 1/1;
    background: #f2ede8;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .h-mv__img-ph svg { width: 60px; opacity: .3; }

  .h-mv__info {
    padding: 10px 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .h-mv__name {
    font-size: 0.8125rem;
    color: #222;
    margin: 0;
    text-align: center;
    font-weight: 400;
    line-height: 1.4;
  }

  .h-mv__btn {
    display: block;
    text-align: center;
    border: 1px solid #bbb;
    padding: 8px 6px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: .1em;
    color: #222;
    text-decoration: none;
    background: #fff;
    transition: background .2s, color .2s, border-color .2s;
    margin-top: auto;
  }
  .h-mv__btn:hover { background: #222; color: #fff; border-color: #222; }

  .h-mv__arrow {
    background: #fff;
    border: none;
    width: 48px;
    flex-shrink: 0;
    font-size: 2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
    transition: color .2s;
    padding: 0;
    line-height: 1;
  }
  .h-mv__arrow:hover { color: #111; }

  @media (max-width: 899px) {
    .h-mv__card { flex: 0 0 50%; }
  }
  @media (max-width: 549px) {
    .h-mv__card { flex: 0 0 85%; }
    .h-mv__arrow { width: 36px; font-size: 1.5rem; }
  }
</style>

<script>
(function() {
  var section = document.querySelector('#h-mv-{{ section.id }}');
  if (!section) return;
  var wrap = section.closest('.h-mv__wrap');

  function getCardW() {
    var card = section.querySelector('.h-mv__card');
    return card ? card.offsetWidth : 0;
  }

  function getVisible() {
    return Math.round(section.offsetWidth / getCardW()) || 1;
  }

  wrap.querySelector('.h-mv__arrow--prev').addEventListener('click', function() {
    section.scrollLeft -= getCardW() * getVisible();
  });
  wrap.querySelector('.h-mv__arrow--next').addEventListener('click', function() {
    section.scrollLeft += getCardW() * getVisible();
  });

  /* touch swipe */
  var startX = 0;
  section.addEventListener('touchstart', function(e){ startX = e.touches[0].clientX; }, {passive:true});
  section.addEventListener('touchend', function(e){
    var dx = startX - e.changedTouches[0].clientX;
    if (Math.abs(dx) > 40) section.scrollLeft += dx > 0 ? getCardW() : -getCardW();
  }, {passive:true});
})();
</script>

{% schema %}
{
  "name": "Los más vendidos",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text",  "id": "heading",  "label": "Título", "default": "LOS MÁS VENDIDOS" },
    { "type": "range", "id": "per_row",  "label": "Productos visibles (escritorio)", "min": 2, "max": 6, "step": 1, "default": 5 },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 60 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Los más vendidos",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
