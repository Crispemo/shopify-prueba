{%- assign col = section.settings.collection -%}

<section class="h-mv">
  <div class="page-width">
    <h2 class="h-mv__title">{{ section.settings.heading }}</h2>
  </div>

  <div class="h-mv__track-wrap page-width">
    <button class="h-mv__arrow h-mv__arrow--prev" aria-label="Anterior" onclick="mvScroll(this, -1)">&#8249;</button>

    <div class="h-mv__track" id="h-mv-track-{{ section.id }}">
      {%- if col != blank -%}
        {%- for product in col.products limit: section.settings.products_limit -%}
          <div class="h-mv__card">
            <a href="{{ product.url }}" class="h-mv__img-link">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="600"
                  height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
                  loading="lazy"
                  class="h-mv__img"
                >
              {%- else -%}
                <div class="h-mv__img-ph">{{ 'product-1' | placeholder_svg_tag }}</div>
              {%- endif -%}
            </a>
            <div class="h-mv__info">
              <p class="h-mv__name">{{ product.title }}</p>
              <a href="{{ product.url }}" class="h-mv__btn">VER PRODUCTO</a>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="h-mv__card">
            <div class="h-mv__img-ph">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
            <div class="h-mv__info">
              <p class="h-mv__name">Producto de ejemplo</p>
              <span class="h-mv__btn">VER PRODUCTO</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <button class="h-mv__arrow h-mv__arrow--next" aria-label="Siguiente" onclick="mvScroll(this, 1)">&#8250;</button>
  </div>
</section>

<style>
  .h-mv {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: #fff;
  }

  .h-mv__title {
    text-align: center;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #111;
    margin: 0 0 40px;
  }

  .h-mv__track-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .h-mv__track {
    display: grid;
    grid-template-columns: repeat({{ section.settings.products_per_row }}, 1fr);
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    flex: 1;
  }
  .h-mv__track::-webkit-scrollbar { display: none; }

  .h-mv__card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }

  .h-mv__img-link { display: block; overflow: hidden; }

  .h-mv__img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
    transition: transform .4s ease;
  }
  .h-mv__img-link:hover .h-mv__img { transform: scale(1.04); }

  .h-mv__img-ph {
    width: 100%;
    aspect-ratio: 3/4;
    background: #f0ede8;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .h-mv__img-ph svg { width: 60px; opacity: .3; }

  .h-mv__info {
    padding: 16px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .h-mv__name {
    font-size: 1rem;
    color: #111;
    margin: 0;
    text-align: center;
    font-weight: 400;
  }

  .h-mv__btn {
    display: block;
    text-align: center;
    border: 1.5px solid #111;
    padding: 10px 8px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: .1em;
    color: #111;
    text-decoration: none;
    background: #fff;
    transition: background .2s, color .2s;
    cursor: pointer;
    margin-top: auto;
  }
  .h-mv__btn:hover { background: #111; color: #fff; }

  .h-mv__arrow {
    background: #fff;
    border: 1.5px solid #ddd;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #111;
    transition: background .2s;
    z-index: 2;
  }
  .h-mv__arrow:hover { background: #f5f5f5; }
  .h-mv__arrow--prev { margin-right: 12px; }
  .h-mv__arrow--next { margin-left: 12px; }

  @media (max-width: 899px) {
    .h-mv__track { grid-template-columns: repeat(2, 1fr); }
    .h-mv__arrow { display: none; }
  }
  @media (max-width: 549px) {
    .h-mv__track { grid-template-columns: repeat(1, 80vw); }
  }
</style>

<script>
  function mvScroll(btn, dir) {
    var track = btn.closest('.h-mv__track-wrap').querySelector('.h-mv__track');
    var cardW = track.querySelector('.h-mv__card').offsetWidth;
    track.scrollBy({ left: dir * cardW, behavior: 'smooth' });
  }
</script>

{% schema %}
{
  "name": "Los más vendidos",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text",       "id": "heading",          "label": "Título",                        "default": "LOS MÁS VENDIDOS" },
    { "type": "collection", "id": "collection",       "label": "Colección de productos" },
    { "type": "range",      "id": "products_limit",   "label": "Número máximo de productos",    "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "range",      "id": "products_per_row", "label": "Columnas en escritorio",        "min": 2, "max": 5,  "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 60 }
  ],
  "presets": [{ "name": "Los más vendidos" }]
}
{% endschema %}
