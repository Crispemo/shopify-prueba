<section class="como-fabricamos color-{{ section.settings.color_scheme }}">
  <div class="como-fabricamos__outer page-width">
    <h2 class="como-fabricamos__heading">{{ section.settings.heading | default: 'Cómo fabricamos las persianas de esparto' }}</h2>
    <div class="como-fabricamos__inner">
      {%- if section.settings.video_url != blank -%}
        {%- if section.settings.video_url contains 'youtu' -%}
          {%- assign video_id = section.settings.video_url | split: 'v=' | last | split: '&' | first -%}
          {%- assign embed_src = 'https://www.youtube.com/embed/' | append: video_id -%}
        {%- else -%}
          {%- assign embed_src = section.settings.video_url -%}
        {%- endif -%}
        <div class="como-fabricamos__video-wrap">
          <iframe
            src="{{ embed_src }}"
            title="{{ section.settings.heading }}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      {%- else -%}
        <div class="como-fabricamos__placeholder">Vídeo próximamente</div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .como-fabricamos {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
  }
  .como-fabricamos__outer { padding: 0 24px; max-width: 1200px; margin: 0 auto; }
  .como-fabricamos__heading {
    text-align: center;
    font-size: 1.625rem;
    font-weight: 700;
    margin-bottom: 32px;
    color: var(--color-foreground);
  }
  .como-fabricamos__inner { max-width: 720px; margin: 0 auto; }
  .como-fabricamos__video-wrap {
    position: relative;
    padding-bottom: 75%;
    height: 0;
    overflow: hidden;
    background: #c4d8d0;
  }
  .como-fabricamos__video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .como-fabricamos__placeholder {
    aspect-ratio: 4/3;
    background: #c4d8d0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 0.875rem;
  }
</style>

{% schema %}
{
  "name": "Cómo fabricamos",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text",  "id": "heading",        "label": "Título",         "default": "Cómo fabricamos las persianas de esparto" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 100, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 56 },
    { "type": "url",   "id": "video_url",      "label": "URL del vídeo (YouTube)" }
  ],
  "presets": [{ "name": "Cómo fabricamos" }]
}
{% endschema %}
