<section class="cf color-{{ section.settings.color_scheme }}">

  {%- if section.settings.eyebrow != blank -%}
    <p class="cf__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}

  <h2 class="cf__heading">{{ section.settings.heading | default: 'Cómo fabricamos las persianas de esparto' }}</h2>

  {%- if section.settings.intro != blank -%}
    <p class="cf__intro">{{ section.settings.intro }}</p>
  {%- endif -%}

  <div class="cf__video-wrap page-width">
    {%- if section.settings.video_url != blank -%}
      {%- if section.settings.video_url contains 'youtu' -%}
        {%- assign video_id = section.settings.video_url | split: 'v=' | last | split: '&' | first -%}
        {%- assign embed_src = 'https://www.youtube.com/embed/' | append: video_id -%}
      {%- else -%}
        {%- assign embed_src = section.settings.video_url -%}
      {%- endif -%}
      <div class="cf__video">
        <iframe
          src="{{ embed_src }}"
          title="{{ section.settings.heading }}"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    {%- else -%}
      <div class="cf__placeholder">
        <span>Vídeo del proceso · Próximamente</span>
      </div>
    {%- endif -%}
  </div>

</section>

<style>
  .cf {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
    text-align: center;
  }
  .cf__eyebrow {
    font-size: 0.75rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #c8824a;
    margin: 0 0 12px;
    font-weight: 600;
  }
  .cf__heading {
    font-size: clamp(1.625rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--color-foreground);
    margin: 0 auto 16px;
    max-width: 700px;
    padding: 0 24px;
    line-height: 1.25;
  }
  .cf__intro {
    font-size: 1.0625rem;
    color: var(--color-foreground);
    opacity: .75;
    max-width: 600px;
    margin: 0 auto 40px;
    padding: 0 24px;
    line-height: 1.65;
  }
  .cf__video-wrap {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .cf__video {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #1a1a1a;
  }
  .cf__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cf__placeholder {
    aspect-ratio: 16/9;
    background: #e8e0d6;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cf__placeholder span {
    font-size: 1rem;
    color: #8a7060;
    letter-spacing: .06em;
  }
</style>

{% schema %}
{
  "name": "Cómo fabricamos",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme",  "label": "Color scheme", "default": "scheme-1" },
    { "type": "text",  "id": "eyebrow",       "label": "Texto pequeño sobre el título", "default": "Artesanía tradicional" },
    { "type": "text",  "id": "heading",        "label": "Título",  "default": "Cómo fabricamos las persianas de esparto" },
    { "type": "text",  "id": "intro",          "label": "Descripción (opcional)", "default": "Cada persiana nace de nuestras manos. Te mostramos el proceso completo, desde la recogida del esparto hasta el producto final listo para tu hogar." },
    { "type": "url",   "id": "video_url",      "label": "URL del vídeo (YouTube / Vimeo)" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 72 }
  ],
  "presets": [{ "name": "Cómo fabricamos" }]
}
{% endschema %}
