<section class="como-medidas color-{{ section.settings.color_scheme }}">
  <div class="como-medidas__inner page-width">
    <h2 class="como-medidas__heading">{{ section.settings.heading | default: 'Cómo tomar las medidas' }}</h2>
    <div class="como-medidas__grid">

      {%- assign slot_keys = 'porche,interna,exterior' | split: ',' -%}

      {%- for key in slot_keys -%}
        {%- assign label_key = 'label_' | append: key -%}
        {%- assign file_key  = 'video_file_' | append: key -%}
        {%- assign url_key   = 'video_' | append: key -%}
        {%- assign label      = section.settings[label_key] -%}
        {%- assign video_file = section.settings[file_key] -%}
        {%- assign video_url  = section.settings[url_key] -%}

        <div class="como-medidas__col">
          <p class="como-medidas__label">{{ label }}</p>

          {%- if video_file != blank -%}
            <div class="como-medidas__video-native">
              {{ video_file | video_tag: autoplay: false, loop: false, controls: true, class: 'como-medidas__video-tag' }}
            </div>
          {%- elsif video_url != blank -%}
            {%- if video_url.type == 'youtube' -%}
              {%- assign embed_src = 'https://www.youtube.com/embed/' | append: video_url.id -%}
            {%- elsif video_url.type == 'vimeo' -%}
              {%- assign embed_src = 'https://player.vimeo.com/video/' | append: video_url.id -%}
            {%- endif -%}
            <div class="como-medidas__video-wrap">
              <iframe
                src="{{ embed_src }}"
                title="{{ label }}"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          {%- else -%}
            <div class="como-medidas__placeholder">Vídeo próximamente</div>
          {%- endif -%}
        </div>
      {%- endfor -%}

    </div>
  </div>
</section>

<style>
  .como-medidas {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
  }
  .como-medidas__inner { padding: 0 24px; max-width: 1200px; margin: 0 auto; }
  .como-medidas__heading {
    text-align: center;
    font-size: clamp(1.625rem, 4vw, 2.25rem);
    font-weight: 700;
    margin-bottom: 40px;
    color: var(--color-foreground);
  }
  .como-medidas__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .como-medidas__col { display: flex; flex-direction: column; gap: 10px; }
  .como-medidas__label {
    text-align: center;
    font-size: 1.0625rem;
    font-weight: 700;
    color: #c8824a;
    margin: 0 0 4px;
    letter-spacing: .02em;
  }
  .como-medidas__video-wrap {
    position: relative;
    padding-bottom: 75%;
    height: 0;
    overflow: hidden;
    background: #c4d8d0;
    border-radius: 8px;
  }
  .como-medidas__video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .como-medidas__video-native { border-radius: 8px; overflow: hidden; }
  .como-medidas__video-tag { width: 100%; display: block; }
  .como-medidas__placeholder {
    aspect-ratio: 4/3;
    background: #e8e0d6;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8a7060;
    font-size: 0.875rem;
  }
  @media (max-width: 640px) {
    .como-medidas__grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Cómo tomar medidas",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text",  "id": "heading",        "label": "Título",            "default": "Cómo tomar las medidas" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 100, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 56 },
    { "type": "header", "content": "Vídeo 1 — Porche" },
    { "type": "text",      "id": "label_porche",      "label": "Etiqueta",          "default": "Porche" },
    { "type": "video",     "id": "video_file_porche",  "label": "Vídeo (archivos de Shopify)" },
    { "type": "video_url", "id": "video_porche",       "label": "O URL de YouTube / Vimeo", "accept": "youtube, vimeo" },
    { "type": "header", "content": "Vídeo 2 — Ventana interna" },
    { "type": "text",      "id": "label_interna",      "label": "Etiqueta",          "default": "Ventana (parte interna)" },
    { "type": "video",     "id": "video_file_interna",  "label": "Vídeo (archivos de Shopify)" },
    { "type": "video_url", "id": "video_interna",       "label": "O URL de YouTube / Vimeo", "accept": "youtube, vimeo" },
    { "type": "header", "content": "Vídeo 3 — Ventana exterior" },
    { "type": "text",      "id": "label_exterior",     "label": "Etiqueta",          "default": "Ventana (exterior)" },
    { "type": "video",     "id": "video_file_exterior", "label": "Vídeo (archivos de Shopify)" },
    { "type": "video_url", "id": "video_exterior",      "label": "O URL de YouTube / Vimeo", "accept": "youtube, vimeo" }
  ],
  "presets": [{ "name": "Cómo tomar medidas" }]
}
{% endschema %}
