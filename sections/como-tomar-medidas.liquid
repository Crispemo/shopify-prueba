<section class="como-medidas color-{{ section.settings.color_scheme }}">
  <div class="como-medidas__inner page-width">
    <h2 class="como-medidas__heading">{{ section.settings.heading | default: 'Cómo tomar las medidas' }}</h2>
    <div class="como-medidas__grid">

      {%- assign cols = 'porche,interna,exterior' | split: ',' -%}
      {%- assign labels = section.settings.label_porche | append: '|||' | append: section.settings.label_interna | append: '|||' | append: section.settings.label_exterior | split: '|||' -%}
      {%- assign urls = section.settings.video_porche | append: '|||' | append: section.settings.video_interna | append: '|||' | append: section.settings.video_exterior | split: '|||' -%}

      {%- for i in (0..2) -%}
        {%- assign label     = labels[i] -%}
        {%- assign video_url = urls[i] -%}
        <div class="como-medidas__col">
          <p class="como-medidas__label">{{ label }}</p>
          {%- if video_url != blank -%}
            {%- if video_url contains 'youtu' -%}
              {%- assign video_id = video_url | split: 'v=' | last | split: '&' | first -%}
              {%- assign embed_src = 'https://www.youtube.com/embed/' | append: video_id -%}
            {%- else -%}
              {%- assign embed_src = video_url -%}
            {%- endif -%}
            <div class="como-medidas__video-wrap">
              <iframe
                src="{{ embed_src }}"
                title="{{ label }}"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          {%- else -%}
            <div class="como-medidas__placeholder">Vídeo próximamente</div>
          {%- endif -%}
        </div>
      {%- endfor -%}

    </div>
  </div>
</section>

<style>
  .como-medidas {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
  }
  .como-medidas__inner { padding: 0 24px; max-width: 1200px; margin: 0 auto; }
  .como-medidas__heading {
    text-align: center;
    font-size: 1.625rem;
    font-weight: 700;
    margin-bottom: 32px;
    color: var(--color-foreground);
  }
  .como-medidas__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .como-medidas__col { display: flex; flex-direction: column; gap: 10px; }
  .como-medidas__label {
    text-align: center;
    font-size: 0.9375rem;
    color: var(--color-foreground);
    margin: 0;
  }
  .como-medidas__video-wrap {
    position: relative;
    padding-bottom: 75%;
    height: 0;
    overflow: hidden;
    background: #c4d8d0;
  }
  .como-medidas__video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .como-medidas__placeholder {
    aspect-ratio: 4/3;
    background: #c4d8d0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 0.875rem;
  }
  @media (max-width: 640px) {
    .como-medidas__grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Cómo tomar medidas",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text",  "id": "heading",        "label": "Título",            "default": "Cómo tomar las medidas" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 100, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 56 },
    { "type": "text",  "id": "label_porche",   "label": "Etiqueta vídeo 1", "default": "Porche" },
    { "type": "url",   "id": "video_porche",   "label": "URL vídeo 1 (YouTube)" },
    { "type": "text",  "id": "label_interna",  "label": "Etiqueta vídeo 2", "default": "Ventana (parte interna)" },
    { "type": "url",   "id": "video_interna",  "label": "URL vídeo 2 (YouTube)" },
    { "type": "text",  "id": "label_exterior", "label": "Etiqueta vídeo 3", "default": "Ventana (exterior)" },
    { "type": "url",   "id": "video_exterior", "label": "URL vídeo 3 (YouTube)" }
  ],
  "presets": [{ "name": "Cómo tomar medidas" }]
}
{% endschema %}
