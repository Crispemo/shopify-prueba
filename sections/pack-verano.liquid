<section class="p-verano">

  {%- if section.settings.bg_image != blank -%}
    <div class="p-verano__bg">
      <img
        src="{{ section.settings.bg_image | image_url: width: 1600 }}"
        alt=""
        width="1600"
        height="{{ 1600 | divided_by: section.settings.bg_image.aspect_ratio | round }}"
        loading="lazy"
        class="p-verano__bg-img"
      >
      <div class="p-verano__overlay"></div>
    </div>
  {%- endif -%}

  <div class="p-verano__inner page-width">

    <div class="p-verano__card">
      {%- if section.settings.badge != blank -%}
        <span class="p-verano__badge">{{ section.settings.badge }}</span>
      {%- endif -%}

      <h2 class="p-verano__heading">{{ section.settings.heading }}</h2>

      {%- if section.settings.subheading != blank -%}
        <p class="p-verano__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="p-verano__body rte">{{ section.settings.body }}</div>
      {%- endif -%}

      <div class="p-verano__actions">
        {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
          <a href="{{ section.settings.button_url }}" class="button button--primary p-verano__btn-primary">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank and section.settings.button2_url != blank -%}
          <a href="{{ section.settings.button2_url }}" class="button button--secondary p-verano__btn-secondary">
            {{ section.settings.button2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>

</section>

<style>
  .p-verano {
    position: relative;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fallback_color }};
    overflow: hidden;
  }

  .p-verano__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .p-verano__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .p-verano__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }

  .p-verano__inner {
    position: relative;
    z-index: 1;
    display: flex;
    {% if section.settings.card_position == 'center' %}
      justify-content: center;
    {% elsif section.settings.card_position == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .p-verano__card {
    background: rgba(255,255,255,{{ section.settings.card_opacity | divided_by: 100.0 }});
    {% if section.settings.card_opacity < 100 %}
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    {% endif %}
    border-radius: 16px;
    padding: 48px 44px;
    max-width: 560px;
    width: 100%;
    {% if section.settings.bg_image == blank %}
    box-shadow: 0 2px 24px rgba(0,0,0,.07);
    {% endif %}
  }

  .p-verano__badge {
    display: inline-block;
    background: #c8824a;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 18px;
  }

  .p-verano__heading {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: {{ section.settings.text_color }};
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .p-verano__sub {
    font-size: 1.0625rem;
    color: {{ section.settings.text_color }};
    opacity: .8;
    margin: 0 0 20px;
    font-weight: 500;
  }

  .p-verano__body {
    font-size: 1rem;
    line-height: 1.75;
    color: {{ section.settings.text_color }};
    opacity: .85;
    margin-bottom: 32px;
  }

  .p-verano__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .p-verano__btn-primary { text-decoration: none; }
  .p-verano__btn-secondary { text-decoration: none; }

  @media (max-width: 749px) {
    .p-verano__card {
      padding: 32px 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Pack de Verano",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Imagen de fondo (opcional)" },
    { "type": "color", "id": "fallback_color", "label": "Color de fondo (sin imagen)", "default": "#f5ede3" },
    { "type": "range", "id": "overlay_opacity", "label": "Opacidad del overlay oscuro", "min": 0, "max": 80, "step": 5, "default": 30, "info": "Solo se aplica si hay imagen de fondo" },
    { "type": "select", "id": "card_position", "label": "Posición de la tarjeta", "options": [
        { "value": "left",   "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right",  "label": "Derecha" }
      ], "default": "left" },
    { "type": "range", "id": "card_opacity", "label": "Opacidad de la tarjeta (%)", "min": 40, "max": 100, "step": 5, "default": 95, "info": "Menos de 100% aplica efecto cristal (glassmorphism)" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#2b2118" },
    { "type": "text",     "id": "badge",      "label": "Badge / etiqueta", "default": "Próximamente" },
    { "type": "text",     "id": "heading",    "label": "Título", "default": "Pack de Verano Jarapa" },
    { "type": "text",     "id": "subheading", "label": "Subtítulo", "default": "Todo lo que necesitas para un verano con estilo natural" },
    { "type": "richtext", "id": "body",       "label": "Descripción", "default": "<p>Estamos preparando algo especial: una selección de productos de esparto y fibras naturales al mejor precio para que tu hogar respire este verano.</p><p>Sé el primero en enterarte cuando esté disponible.</p>" },
    { "type": "text", "id": "button_label",  "label": "Texto botón principal", "default": "Avisarme cuando esté disponible" },
    { "type": "url",  "id": "button_url",    "label": "Enlace botón principal" },
    { "type": "text", "id": "button2_label", "label": "Texto botón secundario (opcional)" },
    { "type": "url",  "id": "button2_url",   "label": "Enlace botón secundario (opcional)" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 160, "step": 8, "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 8, "default": 96 }
  ],
  "presets": [{ "name": "Pack de Verano" }]
}
{% endschema %}
