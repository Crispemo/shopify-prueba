<section class="antes-despues color-{{ section.settings.color_scheme }}">
  <div class="antes-despues__inner page-width">
    <h2 class="antes-despues__heading">{{ section.settings.heading | default: 'Así queda en casa de nuestros clientes' }}</h2>

    {%- if section.blocks.size > 0 -%}
      <div class="ad-wrap" id="ad-wrap-{{ section.id }}">

        {%- if section.blocks.size > section.settings.per_view -%}
          <button class="ad-arrow ad-arrow--prev" aria-label="Anterior" data-id="{{ section.id }}">&#8249;</button>
        {%- endif -%}

        <div class="ad-track" id="ad-track-{{ section.id }}">
          {%- for block in section.blocks -%}
            <div class="ad-slide" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 500 }}"
                  alt="{{ block.settings.image.alt | default: 'Foto de cliente' | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'ad-placeholder' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > section.settings.per_view -%}
          <button class="ad-arrow ad-arrow--next" aria-label="Siguiente" data-id="{{ section.id }}">&#8250;</button>
        {%- endif -%}

      </div>
    {%- else -%}
      <p style="text-align:center;color:#888;padding:24px 0;">Añade imágenes desde el personalizador del tema (botón "Agregar imagen").</p>
    {%- endif -%}
  </div>
</section>

{%- assign per  = section.settings.per_view | default: 5 -%}
{%- assign gap  = 10 -%}
{%- assign gaps = per | minus: 1 | times: gap -%}

<style>
  .antes-despues {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
  }
  .antes-despues__inner { padding: 0 24px; max-width: 1200px; margin: 0 auto; }
  .antes-despues__heading {
    text-align: center;
    font-size: 1.625rem;
    font-weight: 700;
    margin-bottom: 32px;
    color: var(--color-foreground);
  }

  /* Wrapper posicionado para las flechas */
  .ad-wrap { position: relative; }

  /* Track: scroll-snap nativo → funciona en móvil con swipe */
  .ad-track {
    display: flex;
    gap: {{ gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .ad-track::-webkit-scrollbar { display: none; }

  /* Cada slide: ancho calculado para mostrar exactamente per_view imágenes */
  .ad-slide {
    flex: 0 0 calc((100% - {{ gaps }}px) / {{ per }});
    scroll-snap-align: start;
    overflow: hidden;
  }
  .ad-slide img,
  .ad-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  /* Flechas */
  .ad-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(255,255,255,.9);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,.15);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  .ad-arrow--prev { left: -18px; }
  .ad-arrow--next { right: -18px; }
  .ad-arrow:hover { background: #fff; }

  /* Móvil: 2 imágenes visibles */
  @media (max-width: 640px) {
    .ad-slide { flex: 0 0 calc((100% - 10px) / 2); }
    .ad-arrow { display: none; }
  }
</style>

<script>
  (function () {
    var trackEl = document.getElementById('ad-track-{{ section.id }}');
    if (!trackEl) return;
    document.querySelectorAll('.ad-arrow[data-id="{{ section.id }}"]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var slide = trackEl.querySelector('.ad-slide');
        if (!slide) return;
        var step = slide.offsetWidth + {{ gap }};
        var dir  = this.classList.contains('ad-arrow--prev') ? -1 : 1;
        trackEl.scrollBy({ left: dir * step, behavior: 'smooth' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Antes y Después",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "blocks": [
    {
      "type": "imagen",
      "name": "Imagen",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" }
      ]
    }
  ],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme",  "label": "Color scheme", "default": "scheme-1" },
    { "type": "text",         "id": "heading",       "label": "Título",        "default": "Así queda en casa de nuestros clientes" },
    {
      "type": "range",
      "id": "per_view",
      "label": "Imágenes visibles (escritorio)",
      "min": 2, "max": 6, "step": 1, "default": 5
    },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 100, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 56 }
  ],
  "presets": [{ "name": "Antes y Después" }]
}
{% endschema %}
