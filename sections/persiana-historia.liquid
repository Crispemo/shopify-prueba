<section class="p-historia color-{{ section.settings.color_scheme }}">

  {%- if section.settings.eyebrow != blank -%}
    <p class="p-historia__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}

  <h2 class="p-historia__heading">{{ section.settings.heading }}</h2>

  {%- if section.settings.intro != blank -%}
    <p class="p-historia__intro">{{ section.settings.intro }}</p>
  {%- endif -%}

  <div class="p-historia__split page-width{% if section.settings.image_right %} p-historia__split--reverse{% endif %}">

    <div class="p-historia__image-col">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="800"
          height="{{ 800 | divided_by: section.settings.image.aspect_ratio | round }}"
          loading="lazy"
          class="p-historia__img"
        >
      {%- else -%}
        <div class="p-historia__img-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>

    <div class="p-historia__text-col">
      {%- if section.settings.body != blank -%}
        <div class="p-historia__body rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.stat_1_num != blank -%}
        <div class="p-historia__stats">
          {%- if section.settings.stat_1_num != blank -%}
            <div class="p-historia__stat">
              <span class="p-historia__stat-num">{{ section.settings.stat_1_num }}</span>
              <span class="p-historia__stat-label">{{ section.settings.stat_1_label }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.stat_2_num != blank -%}
            <div class="p-historia__stat">
              <span class="p-historia__stat-num">{{ section.settings.stat_2_num }}</span>
              <span class="p-historia__stat-label">{{ section.settings.stat_2_label }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.stat_3_num != blank -%}
            <div class="p-historia__stat">
              <span class="p-historia__stat-num">{{ section.settings.stat_3_num }}</span>
              <span class="p-historia__stat-label">{{ section.settings.stat_3_label }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>

  {%- if section.settings.video_file != blank or section.settings.video_url != blank -%}
    <div class="p-historia__video-wrap page-width">
      {%- if section.settings.video_file != blank -%}
        <div class="p-historia__video p-historia__video--native">
          {{ section.settings.video_file | video_tag: autoplay: false, loop: false, controls: true, class: 'p-historia__video-tag' }}
        </div>
      {%- elsif section.settings.video_url != blank -%}
        {%- assign vid = section.settings.video_url -%}
        {%- if vid.type == 'youtube' -%}
          {%- assign embed_src = 'https://www.youtube.com/embed/' | append: vid.id -%}
        {%- elsif vid.type == 'vimeo' -%}
          {%- assign embed_src = 'https://player.vimeo.com/video/' | append: vid.id -%}
        {%- endif -%}
        <div class="p-historia__video">
          <iframe
            src="{{ embed_src }}"
            title="{{ section.settings.heading }}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

</section>

<style>
  .p-historia {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
    text-align: center;
  }

  .p-historia__eyebrow {
    font-size: 0.75rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #c8824a;
    margin: 0 0 12px;
    font-weight: 600;
  }

  .p-historia__heading {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--color-foreground);
    margin: 0 auto 16px;
    max-width: 700px;
    padding: 0 24px;
    line-height: 1.25;
  }

  .p-historia__intro {
    font-size: 1.0625rem;
    color: var(--color-foreground);
    opacity: .75;
    max-width: 640px;
    margin: 0 auto 48px;
    padding: 0 24px;
    line-height: 1.65;
  }

  /* Split layout — imagen toma 60% del espacio */
  .p-historia__split {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 56px;
    align-items: center;
    text-align: left;
    margin-bottom: 48px;
  }
  .p-historia__split--reverse {
    grid-template-columns: 2fr 3fr;
    direction: rtl;
  }
  .p-historia__split--reverse > * { direction: ltr; }

  .p-historia__img {
    width: 100%;
    height: 100%;
    min-height: 400px;
    max-height: 560px;
    object-fit: cover;
    object-position: center;
    border-radius: 10px;
    display: block;
  }
  .p-historia__img-placeholder {
    min-height: 400px;
    background: #e8e0d6;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .p-historia__img-placeholder svg { width: 60px; opacity: .4; }

  .p-historia__body {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-foreground);
    margin-bottom: 32px;
  }

  /* Stats row */
  .p-historia__stats {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }
  .p-historia__stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .p-historia__stat-num {
    font-size: 1.875rem;
    font-weight: 700;
    color: #c8824a;
    line-height: 1;
  }
  .p-historia__stat-label {
    font-size: 0.8125rem;
    color: var(--color-foreground);
    opacity: .7;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  /* Video */
  .p-historia__video-wrap { max-width: 800px; margin: 0 auto; padding: 0 24px; }
  .p-historia__video {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #1a1a1a;
  }
  .p-historia__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .p-historia__video--native { padding-bottom: 0; height: auto; }
  .p-historia__video-tag { width: 100%; border-radius: 8px; display: block; }

  /* Mobile */
  @media (max-width: 749px) {
    .p-historia__split {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .p-historia__stats { gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Historia & Tradición",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "checkbox", "id": "image_right", "label": "Imagen a la derecha (texto a la izquierda)", "default": false },
    { "type": "text",     "id": "eyebrow",  "label": "Texto pequeño sobre el título", "default": "Pampaneira · Las Alpujarras · Granada" },
    { "type": "text",     "id": "heading",  "label": "Título principal", "default": "Una tradición de siglos desde las Alpujarras" },
    { "type": "text",     "id": "intro",    "label": "Subtítulo / intro", "default": "Las persianas de esparto de Jarapa Home nacen del conocimiento artesanal transmitido de generación en generación en el corazón de la Alpujarra granadina." },
    { "type": "image_picker", "id": "image", "label": "Imagen (foto del taller o las Alpujarras)" },
    { "type": "richtext", "id": "body",     "label": "Texto principal", "default": "<p>El esparto es una fibra natural que crece de forma silvestre en las laderas de Sierra Nevada. Cada persiana se elabora íntegramente a mano, combinando técnicas ancestrales con un acabado contemporáneo que encaja en cualquier hogar.</p><p>Al elegir una persiana de esparto, apuestas por un material 100% natural, duradero y biodegradable, fabricado a pocos kilómetros de donde crece la planta. Sin intermediarios, sin fábricas, sin plástico.</p>" },
    { "type": "text", "id": "stat_1_num",   "label": "Estadística 1 — número",  "default": "+15 años" },
    { "type": "text", "id": "stat_1_label", "label": "Estadística 1 — etiqueta", "default": "de tradición artesanal" },
    { "type": "text", "id": "stat_2_num",   "label": "Estadística 2 — número",  "default": "100%" },
    { "type": "text", "id": "stat_2_label", "label": "Estadística 2 — etiqueta", "default": "fibra natural de esparto" },
    { "type": "text", "id": "stat_3_num",   "label": "Estadística 3 — número",  "default": "A medida" },
    { "type": "text", "id": "stat_3_label", "label": "Estadística 3 — etiqueta", "default": "cada persiana es única" },
    { "type": "video",     "id": "video_file", "label": "Vídeo del proceso (archivos de Shopify)" },
    { "type": "video_url", "id": "video_url",  "label": "O pega una URL de YouTube / Vimeo", "accept": ["youtube", "vimeo"] },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 72 }
  ],
  "presets": [{ "name": "Historia & Tradición" }]
}
{% endschema %}
