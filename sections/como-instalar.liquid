<section class="como-instalar color-{{ section.settings.color_scheme }}">
  <div class="como-instalar__inner page-width">
    <h2 class="como-instalar__heading">{{ section.settings.heading | default: 'Cómo instalar las persianas de esparto' }}</h2>
    <div class="como-instalar__split">

      <div class="como-instalar__video-col">
        {%- if section.settings.video_url != blank -%}
          {%- if section.settings.video_url contains 'youtu' -%}
            {%- assign video_id = section.settings.video_url | split: 'v=' | last | split: '&' | first -%}
            {%- assign embed_src = 'https://www.youtube.com/embed/' | append: video_id -%}
          {%- else -%}
            {%- assign embed_src = section.settings.video_url -%}
          {%- endif -%}
          <div class="como-instalar__video-wrap">
            <iframe
              src="{{ embed_src }}"
              title="{{ section.settings.heading }}"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        {%- else -%}
          <div class="como-instalar__placeholder">Vídeo próximamente</div>
        {%- endif -%}
      </div>

      <div class="como-instalar__text-col">
        {%- if section.settings.instrucciones != blank -%}
          <div class="como-instalar__rte rte">{{ section.settings.instrucciones }}</div>
        {%- else -%}
          <p class="como-instalar__rte">Añade las instrucciones de instalación desde el personalizador.</p>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<style>
  .como-instalar {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
  }
  .como-instalar__inner { padding: 0 24px; max-width: 1200px; margin: 0 auto; }
  .como-instalar__heading {
    text-align: center;
    font-size: clamp(1.625rem, 4vw, 2.25rem);
    font-weight: 700;
    margin-bottom: 40px;
    color: var(--color-foreground);
  }
  .como-instalar__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .como-instalar__video-wrap {
    position: relative;
    padding-bottom: 100%;
    height: 0;
    overflow: hidden;
    background: #c4d8d0;
  }
  .como-instalar__video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .como-instalar__placeholder {
    aspect-ratio: 1;
    background: #c4d8d0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 0.875rem;
  }
  .como-instalar__rte { font-size: 1.0625rem; color: var(--color-foreground); line-height: 1.85; }
  @media (max-width: 640px) {
    .como-instalar__split { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Cómo instalar",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text",     "id": "heading",       "label": "Título",       "default": "Cómo instalar las persianas de esparto" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 100, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 56 },
    { "type": "url",      "id": "video_url",     "label": "URL del vídeo (YouTube)" },
    { "type": "richtext", "id": "instrucciones", "label": "Instrucciones de instalación (texto)" }
  ],
  "presets": [{ "name": "Cómo instalar" }]
}
{% endschema %}
