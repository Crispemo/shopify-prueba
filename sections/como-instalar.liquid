<section class="ci color-{{ section.settings.color_scheme }}">

  {%- if section.settings.eyebrow != blank -%}
    <p class="ci__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}

  <h2 class="ci__heading">{{ section.settings.heading | default: 'Cómo instalar las persianas de esparto' }}</h2>

  {%- if section.settings.intro != blank -%}
    <p class="ci__intro">{{ section.settings.intro }}</p>
  {%- endif -%}

  <div class="ci__split page-width">

    <div class="ci__video-col">
      {%- if section.settings.video_file != blank -%}
        <div class="ci__video-wrap ci__video-wrap--native">
          {{ section.settings.video_file | video_tag: autoplay: false, loop: false, controls: true, class: 'ci__video-tag' }}
        </div>
      {%- elsif section.settings.video_url != blank -%}
        {%- assign vid = section.settings.video_url -%}
        {%- if vid.type == 'youtube' -%}
          {%- assign embed_src = 'https://www.youtube.com/embed/' | append: vid.id -%}
        {%- elsif vid.type == 'vimeo' -%}
          {%- assign embed_src = 'https://player.vimeo.com/video/' | append: vid.id -%}
        {%- endif -%}
        <div class="ci__video-wrap">
          <iframe
            src="{{ embed_src }}"
            title="{{ section.settings.heading }}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      {%- else -%}
        <div class="ci__placeholder">
          <span>Vídeo de instalación · Próximamente</span>
        </div>
      {%- endif -%}
    </div>

    <div class="ci__text-col">
      {%- if section.settings.instrucciones != blank -%}
        <div class="ci__rte rte">{{ section.settings.instrucciones }}</div>
      {%- else -%}
        <p class="ci__rte">Añade las instrucciones desde el personalizador del tema.</p>
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  .ci {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
    text-align: center;
  }
  .ci__eyebrow {
    font-size: 0.75rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #c8824a;
    margin: 0 0 12px;
    font-weight: 600;
  }
  .ci__heading {
    font-size: clamp(1.625rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--color-foreground);
    margin: 0 auto 16px;
    max-width: 700px;
    padding: 0 24px;
    line-height: 1.25;
  }
  .ci__intro {
    font-size: 1.0625rem;
    color: var(--color-foreground);
    opacity: .75;
    max-width: 600px;
    margin: 0 auto 48px;
    padding: 0 24px;
    line-height: 1.65;
  }

  /* Split layout */
  .ci__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    text-align: left;
  }
  .ci__video-wrap {
    position: relative;
    padding-bottom: 100%;
    height: 0;
    overflow: hidden;
    border-radius: 10px;
    background: #1a1a1a;
  }
  .ci__video-wrap iframe { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ci__video-wrap--native { padding-bottom: 0; height: auto; }
  .ci__video-tag { width: 100%; border-radius: 10px; display: block; }
  .ci__placeholder {
    aspect-ratio: 1;
    background: #e8e0d6;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ci__placeholder span {
    font-size: 1rem;
    color: #8a7060;
    letter-spacing: .06em;
  }
  .ci__rte {
    font-size: 1.0625rem;
    color: var(--color-foreground);
    line-height: 1.85;
  }
  .ci__rte ol, .ci__rte ul {
    padding-left: 20px;
  }
  .ci__rte li {
    margin-bottom: 12px;
  }

  @media (max-width: 749px) {
    .ci__split { grid-template-columns: 1fr; gap: 24px; }
  }
</style>

{% schema %}
{
  "name": "Cómo instalar",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme",  "label": "Color scheme", "default": "scheme-1" },
    { "type": "text",     "id": "eyebrow",       "label": "Texto pequeño sobre el título", "default": "Instalación en minutos" },
    { "type": "text",     "id": "heading",        "label": "Título",  "default": "Cómo instalar las persianas de esparto" },
    { "type": "text",     "id": "intro",          "label": "Subtítulo (opcional)", "default": "Es más fácil de lo que parece. En menos de 5 minutos tu persiana estará colocada con el sistema incluido." },
    { "type": "video",     "id": "video_file", "label": "Vídeo (desde archivos de Shopify)" },
    { "type": "video_url", "id": "video_url",  "label": "O pega una URL de YouTube / Vimeo", "accept": "youtube, vimeo" },
    { "type": "richtext", "id": "instrucciones",  "label": "Instrucciones paso a paso" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 72 }
  ],
  "presets": [{ "name": "Cómo instalar" }]
}
{% endschema %}
