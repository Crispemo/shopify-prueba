<div class="persiana-personalizar page-width" style="text-align:center;padding:{{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;">
  <button
    id="btn-personalizar"
    type="button"
    style="display:inline-block;padding:16px 40px;background:#3a2a1a;color:#fff;border:none;cursor:pointer;font-size:1.125rem;font-weight:700;border-radius:4px;letter-spacing:.04em;font-family:inherit;transition:opacity .2s;"
    onmouseover="this.style.opacity='.85'"
    onmouseout="this.style.opacity='1'"
  >
    Personalizar producto
  </button>
</div>

<script>
  document.getElementById('btn-personalizar').addEventListener('click', function () {
    var target = document.querySelector('[id^="MainProduct-"]');
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });
</script>

{% schema %}
{
  "name": "Botón personalizar",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 100, "step": 4, "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 32 }
  ],
  "presets": [{ "name": "Botón personalizar" }]
}
{% endschema %}
