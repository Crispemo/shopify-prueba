<section class="brand-pillars color-{{ section.settings.color_scheme }}">
  <div class="brand-pillars__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="brand-pillars__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="brand-pillars__grid">
      {%- for block in section.blocks -%}
        <div class="brand-pillars__item" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3 class="brand-pillars__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <p class="brand-pillars__body">{{ block.settings.body }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .brand-pillars {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--color-background);
  }
  .brand-pillars__inner {
    max-width: {%- if section.settings.section_width == 'full-width' %}100%{%- else %}1200px{%- endif %};
    margin: 0 auto;
    padding: 0 24px;
  }
  .brand-pillars__heading {
    text-align: center;
    font-size: 1.625rem;
    font-weight: 700;
    margin-bottom: 40px;
    color: var(--color-foreground);
  }
  .brand-pillars__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
  }
  .brand-pillars__item {
    text-align: center;
    padding: 24px;
  }
  .brand-pillars__title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--color-foreground);
  }
  .brand-pillars__body {
    font-size: 0.875rem;
    color: var(--color-foreground);
    line-height: 1.7;
    opacity: 0.8;
  }
</style>

{% schema %}
{
  "name": "Brand Pillars",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Por qué Jarapa Home" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "page-width"
    },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 100, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 56 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pilar",
      "settings": [
        { "type": "text",     "id": "title", "label": "Título" },
        { "type": "textarea", "id": "body",  "label": "Descripción" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Materiales naturales", "body": "Fabricadas con fibra de esparto, sin plásticos ni sintéticos." } },
        { "type": "pillar", "settings": { "title": "Producción artesanal", "body": "Hechas a mano en Pampaneira, Granada, desde 1993." } },
        { "type": "pillar", "settings": { "title": "Sostenibilidad", "body": "Materiales biodegradables y procesos respetuosos con el entorno." } }
      ]
    }
  ]
}
{% endschema %}
